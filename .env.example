# Private root .env only. Never put these credentials in EXPO_PUBLIC_* variables.
# Use an existing PostgreSQL database or create a local database before migrating.
DATABASE_URL=
PORT=8080
SESSION_SECRET=
UBUNTUSAFE_ADMIN_EMAIL=
UBUNTUSAFE_ADMIN_PASSWORD=
# Your own Google AI Studio key. Select an eligible FREE-TIER project/model.
# Do not enable paid billing if you do not want paid API usage.
# Free-tier content may be used to improve Google's products: review terms first.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional per-feature overrides, server-only. Blank = GEMINI_MODEL.
GEMINI_SCAN_MODEL=
GEMINI_VISION_MODEL=
GEMINI_TRANSCRIPTION_MODEL=
# Direct Gmail SMTP. Enable Google 2-Step Verification and create an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
# SMTP_USER = your full Gmail address; SMTP_PASS = Google app password, not login password.
# EMAIL_FROM = same sender, e.g. "UbuntuSafe <your-address@gmail.com>"
EMAIL_FROM=
# SMS is optional. Leave disabled to use Gmail without Twilio charges.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Direct Twilio Account SID (AC...), matching account Auth Token, SMS-capable +number.
# Keep blank on a physical phone for automatic laptop LAN detection.
EXPO_PUBLIC_API_URL=

# Private encrypted backups. Generate a 32-byte base64 key locally; save it separately.
BACKUP_ENABLED=true
BACKUP_CONFIG_ENABLED=true
# Optional local override; blank uses the root .env. Never a mobile EXPO_PUBLIC_* setting.
BACKUP_CONFIG_SOURCE=
BACKUP_ENCRYPTION_KEY=
BACKUP_DIRECTORY=private-backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
# Windows: full paths to the PostgreSQL tools, matching or newer than your DB server.
PG_DUMP_PATH=
PG_RESTORE_PATH=
# Disaster recovery only: a DIFFERENT, EMPTY database. Never point at your live DB.
RESTORE_DATABASE_URL=
