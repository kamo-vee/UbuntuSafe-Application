# Private root .env only. Never put these credentials in EXPO_PUBLIC_* variables.
# Use an existing PostgreSQL database or create a local database before migrating.
DATABASE_URL=
PORT=8080
SESSION_SECRET=
UBUNTUSAFE_ADMIN_EMAIL=
UBUNTUSAFE_ADMIN_PASSWORD=
OPENAI_API_KEY=
# Direct OpenAI API project; valid key + API credit + model permissions required.
OPENAI_SCAN_MODEL=gpt-5-mini
OPENAI_VISION_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Direct Gmail SMTP. Enable Google 2-Step Verification and create an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
# SMTP_USER = your full Gmail address; SMTP_PASS = Google app password, not login password.
# EMAIL_FROM = same sender, e.g. "UbuntuSafe <your-address@gmail.com>"
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Direct Twilio Account SID (AC...), matching account Auth Token, SMS-capable +number.
# Keep blank on a physical phone for automatic laptop LAN detection.
EXPO_PUBLIC_API_URL=
