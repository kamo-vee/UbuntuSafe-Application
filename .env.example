GEMINI_MODEL=gemini-3.1-flash-lite
# Optional per-feature overrides, server-only. Blank = GEMINI_MODEL.
GEMINI_SCAN_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
GEMINI_TRANSCRIPTION_MODEL=gemini-3.1-flash-lite
# Direct Gmail SMTP. Enable Google 2-Step Verification and create an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=boselekamogelo@gmail.com
SMTP_PASS=qykc irgs rhon hbil
SMTP_SECURE=true
# SMTP_USER = your full Gmail address; SMTP_PASS = Google app password, not login password.
# EMAIL_FROM = same sender, e.g. "UbuntuSafe <your-address@gmail.com>"
EMAIL_FROM=boselekamogelo@gmail.com
# SMS is optional. Leave disabled to use Gmail without Twilio charges.
SMS_ENABLED=false

EXPO_PUBLIC_API_URL=

# Private encrypted backups. Generate a 32-byte base64 key locally; save it separately.
BACKUP_ENABLED=true
BACKUP_CONFIG_ENABLED=true
# Optional local override; blank uses the root .env. Never a mobile EXPO_PUBLIC_* setting.
BACKUP_CONFIG_SOURCE=C:/UbuntuSafe-Application/.env
BACKUP_ENCRYPTION_KEY=OxO1n5jaJKONvtWJtynLHBaeZwZC5xrFIQyt33LdwoM=
BACKUP_DIRECTORY=private-backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
# Windows: full paths to the PostgreSQL tools, matching or newer than your DB server.
PG_DUMP_PATH="C:/Program Files/PostgreSQL/18/bin/pg_dump.exe"
PG_RESTORE_PATH="C:/Program Files/PostgreSQL/18/bin/pg_restore.exe"
# Disaster recovery only: a DIFFERENT, EMPTY database. Never point at your live DB.
RESTORE_DATABASE_URL=